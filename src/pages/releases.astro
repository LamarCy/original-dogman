---
import Base from '../layouts/Base.astro';
import { brand, releases, categories, mailto } from '../data/brand.js';
---
<Base path="/releases/" title="Releases"
      description="Original Dogman releases, one at a time. Release 01: the Waxed Cotton Jacket, sold. Release 02 is on the bench.">
  <section>
    <div class="eyebrow"><span class="lbl">Releases</span></div>
    <p class="lede">Three strands, one rule.</p>
    <p>Each release is a small run, made right. They stay here after they&rsquo;re gone.</p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:clamp(16px,2.4vw,28px);margin-top:30px">
      {categories.map((c) => (
        <a href={`/releases/${c.slug}/`}
           style="display:block;text-decoration:none;border:1px solid rgba(255,255,255,.55);border-radius:14px;padding:22px;background:rgba(255,255,255,.46);-webkit-backdrop-filter:blur(16px) saturate(170%);backdrop-filter:blur(16px) saturate(170%);box-shadow:0 10px 26px -16px rgba(44,59,42,.38), inset 0 1px 0 rgba(255,255,255,.8)">
          <h3 style="font-size:19px;margin-bottom:8px">{c.label}</h3>
          <p style="margin:0;color:var(--ink-soft);font-size:16px">{c.lede}</p>
        </a>
      ))}
    </div>
  </section>

  <hr class="rule" />

  {releases.map((r, i) => (
    <>
      <section style={i % 2 ? 'background:var(--bone-2)' : undefined}>
                  <div style="display:grid;grid-template-columns:minmax(0,7rem) 1fr;gap:clamp(18px,3vw,44px);align-items:start">
            <div>
              <div style="font-family:'Zen Kaku Gothic New',system-ui,sans-serif;font-size:clamp(34px,5vw,58px);line-height:1;color:var(--citrine);font-weight:300;letter-spacing:.04em">{r.num}</div>
              <div class="lbl" style="margin-top:8px">{r.year}</div>
            </div>
            <div>
              <h3 style="font-size:clamp(21px,2.6vw,30px)">{r.title}</h3>
              <p style="margin:14px 0 18px">
                <span class={`status ${r.status === 'sold' ? 'sold' : 'upcoming'}`}>
                  {r.status === 'sold' ? 'Sold' : 'On the bench'}
                </span>
              </p>
              <p>{r.long || r.description}</p>

              {r.materials && (
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-top:26px;padding-top:22px;border-top:1px solid var(--rule)">
                  <div><div class="lbl">Materials</div><p style="margin:6px 0 0">{r.materials}</p></div>
                  <div><div class="lbl">Run</div><p style="margin:6px 0 0">One in a small run</p></div>
                  <div><div class="lbl">Provenance</div><p style="margin:6px 0 0">{r.provenance}</p></div>
                </div>
              )}

              {r.image && (
                <div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-top:28px;align-items:start">
                  <img src={r.image} alt={r.alt} width="1400" height="1400" />
                  <img src={r.detail} alt="Detail of the custom-printed lining." width="500" height="500"
                       style="border:1px solid var(--rule)" />
                </div>
              )}

              {r.status === 'upcoming' && (
                <a class="cta" style="margin-top:8px" href={mailto(`${brand.name} — next release`)}>Get first word</a>
              )}
            </div>
          </div>
        </div>
      </section>
      <hr class="rule" />
    </>
  ))}
</Base>
